{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "linter": {
    "rules": {
      "performance": {
        // React Compiler memoizes inline handlers; useCallback is banned here
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        // False positives: flags reachable switch cases on useState union types
        "noUnnecessaryConditions": "off"
      }
    }
  }
}
