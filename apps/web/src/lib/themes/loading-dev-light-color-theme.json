{
  "$schema": "vscode://schemas/color-theme",
  "name": "loading.dev Light",
  "type": "light",
  "colors": {
    "editor.background": "#fbfbfb",
    "editor.foreground": "#141413",
    "editorLineNumber.foreground": "#6c6b6880",
    "editorLineNumber.activeForeground": "#6c6b68",
    "editorCursor.foreground": "#ef551a",
    "editor.selectionBackground": "#1414131a",
    "editor.inactiveSelectionBackground": "#1414130f",
    "editor.lineHighlightBackground": "#14141308",
    "editor.wordHighlightBackground": "#1414130f",
    "editorIndentGuide.background1": "#1414130d",
    "editorIndentGuide.activeBackground1": "#1414131a",
    "editorWhitespace.foreground": "#1414130d",
    "editorBracketMatch.background": "#1414131a",
    "editorBracketMatch.border": "#ef551a80",

    "focusBorder": "#ef551a",
    "foreground": "#141413",
    "descriptionForeground": "#6c6b68",

    "sideBar.background": "#ffffff",
    "sideBar.foreground": "#6c6b68",
    "sideBarTitle.foreground": "#141413",
    "sideBar.border": "#1414130d",

    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#141413",
    "activityBar.inactiveForeground": "#6c6b68",
    "activityBar.border": "#1414130d",
    "activityBarBadge.background": "#ef551a",
    "activityBarBadge.foreground": "#ffffff",

    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#6c6b68",
    "statusBar.border": "#1414130d",
    "statusBar.debuggingBackground": "#ef551a",
    "statusBar.debuggingForeground": "#ffffff",

    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#141413",
    "titleBar.inactiveBackground": "#ffffff",
    "titleBar.inactiveForeground": "#6c6b68",

    "tab.activeBackground": "#fbfbfb",
    "tab.activeForeground": "#141413",
    "tab.inactiveBackground": "#ffffff",
    "tab.inactiveForeground": "#6c6b68",
    "tab.border": "#1414130d",
    "tab.activeBorderTop": "#ef551a",
    "editorGroupHeader.tabsBackground": "#ffffff",
    "editorGroup.border": "#1414130d",

    "panel.background": "#ffffff",
    "panel.border": "#1414130d",
    "panelTitle.activeForeground": "#141413",
    "panelTitle.inactiveForeground": "#6c6b68",

    "input.background": "#14141308",
    "input.foreground": "#141413",
    "input.border": "#1414130d",
    "input.placeholderForeground": "#6c6b6880",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#141413",
    "dropdown.border": "#1414130d",

    "button.background": "#ef551a",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#ef551ad9",
    "button.secondaryBackground": "#14141308",
    "button.secondaryForeground": "#141413",

    "badge.background": "#ef551a",
    "badge.foreground": "#ffffff",

    "list.activeSelectionBackground": "#1414131a",
    "list.activeSelectionForeground": "#141413",
    "list.inactiveSelectionBackground": "#1414130f",
    "list.hoverBackground": "#14141308",
    "list.focusBackground": "#1414131a",
    "list.highlightForeground": "#ef551a",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#1414131a",
    "scrollbarSlider.hoverBackground": "#14141333",
    "scrollbarSlider.activeBackground": "#1414134d",

    "widget.shadow": "#00000014",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#1414130d",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#1414130d",
    "editorSuggestWidget.selectedBackground": "#1414131a",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#1414130d",

    "peekView.border": "#ef551a",
    "peekViewEditor.background": "#ffffff",
    "peekViewResult.background": "#ffffff",
    "peekViewTitle.background": "#fbfbfb",

    "gitDecoration.addedResourceForeground": "#02bc83",
    "gitDecoration.modifiedResourceForeground": "#ef551a",
    "gitDecoration.deletedResourceForeground": "#e5484d",
    "gitDecoration.untrackedResourceForeground": "#1ed6ff",

    "terminal.background": "#ffffff",
    "terminal.foreground": "#141413",
    "terminal.ansiRed": "#e5484d",
    "terminal.ansiGreen": "#02bc83",
    "terminal.ansiYellow": "#ef551a",
    "terminal.ansiBlue": "#1ed6ff",
    "terminal.ansiMagenta": "#9353cc",
    "terminal.ansiCyan": "#1ed6ff",
    "terminal.ansiWhite": "#141413",
    "terminal.ansiBlack": "#ffffff",
    "terminal.ansiBrightBlack": "#6c6b68"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6c6b68", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation, plain text",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "source",
        "text.plain"
      ],
      "settings": { "foreground": "#6c6b68" }
    },
    {
      "name": "Keywords, storage, control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#ef551a" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#1ed6ff" }
    },
    {
      "name": "Types, classes, JSX/HTML tags, components",
      "scope": [
        "entity.name.tag",
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "meta.jsx.children entity.name.tag"
      ],
      "settings": { "foreground": "#9353cc" }
    },
    {
      "name": "Constants, numbers, booleans, values",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": { "foreground": "#02bc83" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#141413" }
    },
    {
      "name": "Variables, attributes, properties",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#141413" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ef551a" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#ef551a", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold/italic",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#1ed6ff" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e5484d" }
    }
  ]
}
